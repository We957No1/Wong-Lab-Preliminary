+def figure_png_bytes(fig):
+    """Encode a closed-over figure without invoking an IPython display hook."""
+    from io import BytesIO
+    buffer=BytesIO()
+    fig.savefig(buffer,format='png',dpi=115,bbox_inches='tight')
+    return buffer.getvalue()
+
+
+def plot_image_slots(titles):
+    """One persistent Image widget per distinct figure; updates replace bytes."""
+    import ipywidgets as widgets
+    images=tuple(widgets.Image(format='png',
+        layout=widgets.Layout(width='100%',max_width='1600px')) for _ in titles)
+    children=[]
+    for title,view in zip(titles,images):
+        children.extend([widgets.HTML(f'<b>{title}</b>'),view])
+    box=widgets.VBox(children,layout=widgets.Layout(display='none'))
+    return box,images
+
+
+def close_dashboard(dashboard):
+    """Disconnect and close a previous panel when its notebook cell is rerun."""
+    if not dashboard:return
+    if 'button' in dashboard and 'compute' in dashboard:
+        dashboard['button'].on_click(dashboard['compute'],remove=True)
+    visited=set()
+    def close(widget):
+        if widget is None or id(widget) in visited:return
+        visited.add(id(widget))
+        for child in getattr(widget,'children',()):close(child)
+        widget.close()
+    close(dashboard.get('ui'))
+
