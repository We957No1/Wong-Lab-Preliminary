\@writefile{lof}{\contentsline {figure}{\numberline {4.1}{\ignorespaces Airy intensity pattern for a uniformly illuminated, unobscured circular pupil with no aberration. Coordinates are measured in units of $\lambda /\mathrm  {NA}$, and intensity is normalized to its on-axis value. (a) The image-plane pattern uses a logarithmic colour scale to reveal the faint rings; colour does not represent wavelength. (b) The radial intensity on a linear scale shows the dominant central spot. The dashed line marks the first dark ring at $r=0.6098\lambda /\mathrm  {NA}$. (c) The same radial profile on a logarithmic scale reveals the outer rings. The first bright ring reaches only about $1.75$ percent of the central peak. The logarithmic displays stop at $I/I(0)=10^{-5}$; the ideal dark-ring minima are zero.}}{17}{figure.89}\protected@file@percent }
\newlabel{fig:airy-pattern}{{4.1}{17}{Airy intensity pattern for a uniformly illuminated, unobscured circular pupil with no aberration. Coordinates are measured in units of $\lambda /\NA $, and intensity is normalized to its on-axis value. (a) The image-plane pattern uses a logarithmic colour scale to reveal the faint rings; colour does not represent wavelength. (b) The radial intensity on a linear scale shows the dominant central spot. The dashed line marks the first dark ring at $r=0.6098\lambda /\NA $. (c) The same radial profile on a logarithmic scale reveals the outer rings. The first bright ring reaches only about $1.75$ percent of the central peak. The logarithmic displays stop at $I/I(0)=10^{-5}$; the ideal dark-ring minima are zero}{figure.89}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4.4}Coherent and incoherent resolution are different questions}{17}{section*.90}\protected@file@percent }
\newlabel{eq:otf}{{4.9}{17}{Coherent and incoherent resolution are different questions}{equation*.91}{}}
\newlabel{eq:sinusoidal-mask}{{4.10}{18}{Optical system and mask, common to both cases}{equation*.94}{}}
\newlabel{eq:sinusoid-coherent}{{4.11}{19}{Case A: the pupil removes the field sidebands}{equation*.97}{}}
\newlabel{eq:circular-incoherent-otf}{{4.12}{19}{Case B: some intensity modulation survives}{equation*.99}{}}
\newlabel{eq:sinusoid-incoherent}{{4.13}{19}{Case B: some intensity modulation survives}{equation*.100}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces Sinusoidal-mask comparison under the optical and source conditions stated in Section~4.4. (a) The coherent curve transfers field amplitude; the incoherent curve transfers intensity modulation. Their common pupil has field cutoff $f_c$, while $q=1.5f_c$ lies inside the intensity cutoff $2f_c$. (b) Mask intensity transmission and the two images use one common grayscale, with no separate contrast stretching. (c) The corresponding profiles are divided by $t_0^2$ after the stated flat-field calibration. Case A uses one normally incident coherent wave; Case B averages a uniform disk of mutually incoherent source directions with illumination NA $0.15$. The objective NA is $0.05$ in both cases. The incoherent image retains $2.87$ percent contrast; the coherent image is uniform.}}{20}{figure.101}\protected@file@percent }
\newlabel{fig:coherence-comparison}{{4.2}{20}{Sinusoidal-mask comparison under the optical and source conditions stated in Section~4.4. (a) The coherent curve transfers field amplitude; the incoherent curve transfers intensity modulation. Their common pupil has field cutoff $f_c$, while $q=1.5f_c$ lies inside the intensity cutoff $2f_c$. (b) Mask intensity transmission and the two images use one common grayscale, with no separate contrast stretching. (c) The corresponding profiles are divided by $t_0^2$ after the stated flat-field calibration. Case A uses one normally incident coherent wave; Case B averages a uniform disk of mutually incoherent source directions with illumination NA $0.15$. The objective NA is $0.05$ in both cases. The incoherent image retains $2.87$ percent contrast; the coherent image is uniform}{figure.101}{}}
